# Copy to .env (cp .env.example .env) and run: docker compose up --build
# Public port of the web app (http://localhost:8080)
WEB_PORT=8080

# Random string, at least 32 characters. CHANGE IT outside local testing.
JWT_SECRET=change-me-change-me-change-me-change-me
# Password of every seeded account (superadmin@, admin@, teacher1@, teacher2@, student1@, student2@, student3@educore.example)
SEED_ADMIN_PASSWORD=ChangeMe!12345
# true = create test data (accounts, courses, enrollments) on the first start
SEED_DEMO=true
# true = login screen shows Student / Teacher / Admin quick sign-in buttons (testing only: set false for real use)
DEMO_LOGIN=true

ALLOW_PUBLIC_REGISTRATION=false
ALLOWED_EMAIL_DOMAIN=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
