# Public host name. A real domain => Caddy obtains a Let's Encrypt certificate automatically. "localhost" => local self-signed.
SITE_ADDRESS=educore.example.com
# --- backend (see backend/.env.example for all options) ---
JWT_SECRET=generate-with-openssl-rand-base64-48
SEED_ADMIN_PASSWORD=choose-a-strong-one
ALLOW_PUBLIC_REGISTRATION=false
ALLOWED_EMAIL_DOMAIN=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
